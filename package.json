{
  "name": "lesezeit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('fs').promises.rm('dist',{recursive:true,force:true})\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "pwa-assets-generator",
    "test:e2e": "playwright test",
    "lock:check": "node scripts/lockfile.mjs check",
    "lock:refresh": "node scripts/lockfile.mjs refresh",
    "dict:build": "node --max-old-space-size=8192 scripts/dict/build.ts",
    "test:unit": "node --test scripts/dict/lib.test.ts pipeline/pipeline.test.ts pipeline/ai.test.ts src/lib/speech.test.ts src/lib/vocab.test.ts",
    "pipeline": "node pipeline/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  }
}
